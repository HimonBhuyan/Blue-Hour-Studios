# Apache Configuration for Blue Hour Studio
Options -Indexes
ServerSignature Off

# Protect sensitive storage folders from direct browser downloads
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^storage/(.*)$ - [F,L]
    RewriteRule ^data/(.*)$ - [F,L]

    # Clean SEO routes for service pages, portfolio & contact
    RewriteRule ^website-development/?$ website-development.php [L,QSA]
    RewriteRule ^ecommerce-development/?$ ecommerce-development.php [L,QSA]
    RewriteRule ^social-media-management/?$ social-media-management.php [L,QSA]
    RewriteRule ^branding-design/?$ branding-design.php [L,QSA]
    RewriteRule ^seo-digital-marketing/?$ seo-digital-marketing.php [L,QSA]
    RewriteRule ^portfolio/?$ works.php [L,QSA]
    RewriteRule ^contact/?$ contact.php [L,QSA]
</IfModule>

# Enable GZIP / Deflate Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript application/json
</IfModule>

# Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>
